{
  "schema_version": "clozn.model-routing.v1",
  "protocol": {
    "surface": "ollama",
    "route": "/api/chat"
  },
  "request": {
    "request_id": "req_unknown",
    "requested_model": "not-configured",
    "selection_source": "explicit",
    "load_policy": "fail_fast"
  },
  "policy": {
    "default_model_id": "qwen-default",
    "max_loaded_workers": 2,
    "preload_model_ids": ["qwen-default"],
    "load_queue_limit": 8,
    "generation_queue_limit": 16,
    "load_timeout_ms": 180000,
    "queue_timeout_ms": 600000,
    "eviction_policy": "lru_idle",
    "active_worker_eviction": "forbidden",
    "cold_load_coalescing": true,
    "cancellation": "request_scoped_release_permits",
    "omitted_model_policy": "configured_default",
    "unknown_model_policy": "error_no_fallback",
    "alias_policy": "mutable_config_immutable_receipt"
  },
  "result": {
    "status": "error",
    "lifecycle_state": "unloaded",
    "receipt": {
      "requested_model": "not-configured",
      "selection_source": "explicit",
      "load_event": {
        "event_id": null,
        "kind": "not_started",
        "outcome": "not_started",
        "state_before": "unloaded",
        "state_after": "unloaded",
        "coalesced": false,
        "wait_ms": 0
      }
    },
    "error": {
      "code": "unknown_model",
      "http_status": 404,
      "retryable": false,
      "phase": "resolution",
      "message": "requested model is not configured"
    }
  }
}
