{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clozn.context-dependence-study.v1",
  "title": "Direct Context Dependence study",
  "description": "A set-valued, teacher-forced measurement of how the exact recorded continuation changes when one or more canonical Context Receipt sources are deleted. This is additive to clozn.context_answer_influence.v1: it does not use that artifact's matched-length replacement semantics and consumers must not reinterpret either artifact as the other. Every experiment is a directly scored intervention (provenance=measured); estimated screens and search/verification layers may be added as optional future fields.",
  "type": "object",
  "required": [
    "schema_version", "study_id", "run_id", "context_model_identity", "source_identity",
    "target", "continuation", "baseline", "experiments", "budget"
  ],
  "properties": {
    "schema_version": {"const": "clozn.context-dependence-study.v1"},
    "study_id": {"type": "string", "pattern": "^cds_[0-9a-f]{24}$"},
    "run_id": {"type": "string", "minLength": 1},
    "context_model_identity": {
      "type": "object",
      "description": "Recorded model/runtime identity plus available tokenizer/template/rendered-prompt identity facets, bound into study and experiment identities.",
      "additionalProperties": true
    },
    "source_identity": {"$ref": "#/$defs/source_identity"},
    "target": {"$ref": "#/$defs/target"},
    "continuation": {"$ref": "#/$defs/continuation"},
    "baseline": {"$ref": "#/$defs/baseline"},
    "experiments": {
      "type": "array",
      "items": {"$ref": "#/$defs/experiment"},
      "description": "Only direct measured set deletions produced by this primitive. The empty list is valid for a prepared study before an intervention is requested."
    },
    "screen": {
      "type": "object",
      "description": "Reserved for a future estimated random-subset surrogate. It is not produced by the Task 1 direct measurement primitive.",
      "additionalProperties": true
    },
    "verified_sets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_ids", "experiment_id"],
        "properties": {
          "source_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "experiment_id": {"type": "string", "pattern": "^cdx_[0-9a-f]{24}$"}
        },
        "additionalProperties": true
      },
      "description": "Reserved for later measured coalition verification; never inferred from an estimated screen."
    },
    "budget": {"$ref": "#/$defs/budget"}
  },
  "additionalProperties": true,
  "$defs": {
    "range": {
      "type": "array",
      "items": {"type": "integer", "minimum": 0},
      "minItems": 2,
      "maxItems": 2,
      "description": "Half-open [start, end) range. The producer additionally enforces start < end where a non-empty target is required."
    },
    "target": {
      "type": "object",
      "required": ["unicode_range", "recorded_token_range", "recorded_prefix_range", "unicode_offset_basis"],
      "properties": {
        "unicode_range": {"$ref": "#/$defs/range"},
        "recorded_token_range": {"$ref": "#/$defs/range"},
        "recorded_prefix_range": {
          "type": "array",
          "items": {"type": "integer", "minimum": 0},
          "minItems": 2,
          "maxItems": 2,
          "description": "The exact recorded continuation token prefix conditioned before the target. It may be empty ([0, 0])."
        },
        "unicode_offset_basis": {"const": "teacher_forced_scored_continuation"}
      },
      "additionalProperties": true
    },
    "continuation": {
      "type": "object",
      "required": ["kind", "token_ids_exact", "retokenized", "recorded_text"],
      "properties": {
        "kind": {"enum": ["recorded_token_ids", "recorded_response_text_retokenized_approximate"]},
        "token_ids_exact": {"type": "boolean"},
        "retokenized": {"type": "boolean"},
        "recorded_text": {"type": "string"},
        "token_ids": {"type": "array", "items": {"type": "integer"}}
      },
      "additionalProperties": true
    },
    "source_identity": {
      "type": "object",
      "required": ["kind", "view", "sources"],
      "properties": {
        "kind": {"const": "context_receipt_segment_id"},
        "view": {"enum": ["assembled", "delivered"]},
        "sources": {
          "type": "array",
          "items": {"$ref": "#/$defs/source"}
        }
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "required": ["source_id", "segment_id", "message_index", "unicode_range", "byte_range", "role"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "segment_id": {"type": "string", "minLength": 1},
        "message_index": {"type": "integer", "minimum": 0},
        "unicode_range": {"$ref": "#/$defs/range"},
        "byte_range": {"$ref": "#/$defs/range"},
        "role": {"type": "string"},
        "client_source_id": {"type": "string", "minLength": 1},
        "source_label": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "baseline": {
      "type": "object",
      "required": ["teacher_forced_logp", "context_hash", "scored_once", "provenance"],
      "properties": {
        "teacher_forced_logp": {"type": "number"},
        "context_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "scored_once": {"const": true},
        "provenance": {"const": "measured"}
      },
      "additionalProperties": true
    },
    "removed_range": {
      "type": "object",
      "required": ["source_id", "message_index", "unicode_range", "byte_range"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "message_index": {"type": "integer", "minimum": 0},
        "unicode_range": {"$ref": "#/$defs/range"},
        "byte_range": {"$ref": "#/$defs/range"}
      },
      "additionalProperties": true
    },
    "experiment": {
      "type": "object",
      "required": [
        "experiment_id", "intervention_operator", "removed_source_ids", "exact_removed_ranges",
        "context_hash", "target_logp", "baseline_target_logp", "delta_nats",
        "per_target_token_delta_nats", "target_token_indices", "provenance"
      ],
      "properties": {
        "experiment_id": {"type": "string", "pattern": "^cdx_[0-9a-f]{24}$"},
        "intervention_operator": {"const": "delete_source"},
        "removed_source_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "exact_removed_ranges": {"type": "array", "items": {"$ref": "#/$defs/removed_range"}, "minItems": 1},
        "context_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "target_logp": {"type": "number"},
        "baseline_target_logp": {"type": "number"},
        "delta_nats": {"type": "number", "description": "full-context target logp minus deleted-context target logp; positive means this exact removal made the recorded target less likely."},
        "per_target_token_delta_nats": {"type": "array", "items": {"type": "number"}, "minItems": 1},
        "target_token_indices": {"type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 1},
        "provenance": {"const": "measured"},
        "score_ms": {"type": "number", "minimum": 0}
      },
      "additionalProperties": true
    },
    "budget": {
      "type": "object",
      "required": ["passes_requested", "passes_consumed"],
      "properties": {
        "passes_requested": {"type": "integer", "minimum": 1},
        "passes_consumed": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": true
    }
  }
}
