{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clozn.context-dependence-query.v1",
  "title": "Exact answer-selection projection over run-level Context Dependence",
  "description": "A read-only projection over a persisted clozn.context-dependence-study.v2. Each returned effect is a sum of that direct experiment's already-persisted full per-token delta vector over one exact recorded-token selection; this artifact never requests a model call or infers an importance label.",
  "type": "object",
  "required": ["schema_version", "run_id", "selection", "measurement", "measured_removal_effects"],
  "properties": {
    "schema_version": {"const": "clozn.context-dependence-query.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "selection": {"$ref": "#/$defs/selection"},
    "measurement": {"$ref": "#/$defs/measurement"},
    "measured_removal_effects": {
      "type": "array",
      "items": {"$ref": "#/$defs/effect"},
      "description": "All direct delete-source experiments persisted in the selected v2 study, in stored experiment order. An empty array means the study has no direct intervention arms."
    },
    "matched_length_neutralization_controls": {
      "type": "array",
      "items": {"$ref": "#/$defs/neutralization_control_effect"},
      "description": "Optional separately measured robustness controls. These observations use matched Unicode-code-point neutral filler and must not be blended into measured_removal_effects."
    }
  },
  "additionalProperties": false,
  "$defs": {
    "range": {
      "type": "array",
      "items": {"type": "integer", "minimum": 0},
      "minItems": 2,
      "maxItems": 2,
      "description": "Half-open Unicode or recorded-token coordinates. Runtime validation proves ordering and token-boundary registration."
    },
    "selection": {
      "type": "object",
      "required": ["unicode_range", "text", "registration", "fidelity", "recorded_token_range", "conditioned_prefix"],
      "properties": {
        "unicode_range": {"$ref": "#/$defs/range"},
        "text": {"type": "string", "minLength": 1},
        "registration": {"enum": ["exact", "recomputed"]},
        "fidelity": {"enum": ["exact_recorded_token_ids", "recomputed_from_recorded_response_text"]},
        "recorded_token_range": {"$ref": "#/$defs/range"},
        "conditioned_prefix": {
          "type": "object",
          "required": ["unicode_range", "recorded_token_range", "text"],
          "properties": {
            "unicode_range": {"$ref": "#/$defs/range"},
            "recorded_token_range": {"$ref": "#/$defs/range"},
            "text": {"type": "string"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "measurement": {
      "type": "object",
      "required": ["state", "study_schema_version", "intervention_operator", "provenance"],
      "properties": {
        "state": {"const": "available"},
        "study_schema_version": {"const": "clozn.context-dependence-study.v2"},
        "intervention_operator": {"const": "delete_source"},
        "provenance": {"const": "measured"}
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["source_id", "message_index", "unicode_range", "byte_range"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "segment_id": {"type": "string", "minLength": 1},
        "message_index": {"type": "integer", "minimum": 0},
        "unicode_range": {"$ref": "#/$defs/range"},
        "byte_range": {"$ref": "#/$defs/range"},
        "role": {"type": "string"},
        "client_source_id": {"type": "string", "minLength": 1},
        "source_label": {"type": "string", "minLength": 1},
        "provenance_kind": {"type": "string", "minLength": 1},
        "source_kind": {"type": "string", "minLength": 1},
        "parent_source_id": {"type": "string", "minLength": 1},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "removed_range": {
      "type": "object",
      "required": ["source_id", "message_index", "unicode_range", "byte_range"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "message_index": {"type": "integer", "minimum": 0},
        "unicode_range": {"$ref": "#/$defs/range"},
        "byte_range": {"$ref": "#/$defs/range"}
      },
      "additionalProperties": false
    },
    "effect": {
      "type": "object",
      "required": [
        "experiment_id", "intervention_operator", "provenance", "removed_source_ids", "sources",
        "exact_removed_ranges", "delta_nats", "full_continuation_delta_nats"
      ],
      "properties": {
        "experiment_id": {"type": "string", "minLength": 1},
        "intervention_operator": {"const": "delete_source"},
        "provenance": {"const": "measured"},
        "removed_source_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}, "minItems": 1},
        "exact_removed_ranges": {"type": "array", "items": {"$ref": "#/$defs/removed_range"}, "minItems": 1},
        "delta_nats": {"type": "number", "description": "Direct measured deletion effect summed over the selected exact recorded-token interval."},
        "full_continuation_delta_nats": {"type": "number", "description": "The same directly measured experiment summed over its full recorded-continuation vector."}
      },
      "additionalProperties": false
    },
    "effective_neutralized_range": {
      "type": "object",
      "required": [
        "message_index", "unicode_range", "original_content_sha256", "replacement_content_sha256",
        "original_unicode_code_points", "replacement_unicode_code_points",
        "original_utf8_bytes", "replacement_utf8_bytes"
      ],
      "properties": {
        "message_index": {"type": "integer", "minimum": 0},
        "unicode_range": {"$ref": "#/$defs/range"},
        "original_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "replacement_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "original_unicode_code_points": {"type": "integer", "minimum": 1},
        "replacement_unicode_code_points": {"type": "integer", "minimum": 1},
        "original_utf8_bytes": {"type": "integer", "minimum": 1},
        "replacement_utf8_bytes": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "neutralization": {
      "type": "object",
      "required": [
        "operator", "strategy", "recipe", "length_contract", "utf8_byte_length_contract",
        "message_structure"
      ],
      "properties": {
        "operator": {"const": "neutralize_source"},
        "strategy": {"const": "matched_length_neutral_filler"},
        "recipe": {"const": "clozn.matched_length_neutral_filler.v1"},
        "length_contract": {"const": "unicode_code_points_exact"},
        "utf8_byte_length_contract": {"const": "not_guaranteed"},
        "message_structure": {"const": "preserved"}
      },
      "additionalProperties": false
    },
    "neutralization_control_effect": {
      "type": "object",
      "required": [
        "control_id", "intervention_operator", "provenance", "neutralized_source_ids", "sources",
        "exact_neutralized_ranges", "effective_neutralized_ranges", "neutralization",
        "delta_nats", "full_continuation_delta_nats"
      ],
      "properties": {
        "control_id": {"type": "string", "minLength": 1},
        "intervention_operator": {"const": "neutralize_source"},
        "provenance": {"const": "measured_matched_length_neutralization_control"},
        "neutralized_source_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
        "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}, "minItems": 1},
        "exact_neutralized_ranges": {"type": "array", "items": {"$ref": "#/$defs/removed_range"}, "minItems": 1},
        "effective_neutralized_ranges": {"type": "array", "items": {"$ref": "#/$defs/effective_neutralized_range"}, "minItems": 1},
        "neutralization": {"$ref": "#/$defs/neutralization"},
        "delta_nats": {"type": "number", "description": "Separately measured matched-length neutralization effect summed over the selected exact recorded-token interval."},
        "full_continuation_delta_nats": {"type": "number", "description": "The same separately measured control summed over its full recorded-continuation vector."}
      },
      "additionalProperties": false
    }
  }
}
