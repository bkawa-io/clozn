{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clozn.branch-fan.v1",
  "title": "Branch Fan -- bounded execution over recorded alternatives",
  "description": "A live orchestration projection over ordinary child runs. It selects only alternatives already recorded at one response-token boundary, executes branches sequentially through the existing exact-first fork policy, and compares successful children with the canonical run diff. It is not an experiment entity, attribution result, diagnosis, or semantic conclusion. rank_class is not present here; per-branch fidelity is authoritative only in the child execution-fork receipt. This response contains metadata, ids, probabilities, and compact evidence projections, never checkpoint bytes or worker-private paths.",
  "type": "object",
  "required": ["schema_version", "parent_run_id", "position", "selection", "execution", "branches", "summary"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "clozn.branch-fan.v1"},
    "parent_run_id": {"type": "string", "minLength": 1},
    "position": {
      "type": "integer",
      "minimum": 0,
      "description": "Recorded response-token index. Rewind occurs immediately before this token, matching Execution Fork coordinates."
    },
    "selection": {"$ref": "#/$defs/selection"},
    "execution": {"$ref": "#/$defs/execution"},
    "branches": {"type": "array", "items": {"$ref": "#/$defs/branch"}},
    "summary": {"$ref": "#/$defs/summary"}
  },
  "$defs": {
    "selection": {
      "type": "object",
      "required": ["source", "state", "requested_limit"],
      "additionalProperties": false,
      "properties": {
        "source": {"const": "recorded_alternatives"},
        "state": {"enum": ["available", "unavailable"]},
        "recorded_alternatives": {"type": "integer", "minimum": 0},
        "selected_alternatives": {"type": "integer", "minimum": 0},
        "requested_limit": {"type": "integer", "minimum": 1, "maximum": 4},
        "reason": {"enum": ["no_recorded_alternatives"]}
      }
    },
    "checkpoint_capture": {
      "type": "object",
      "required": ["state", "reused_for_exact_candidates"],
      "additionalProperties": false,
      "properties": {
        "state": {"enum": ["available", "unavailable", "not_attempted"]},
        "reused_for_exact_candidates": {"type": "boolean"},
        "reason": {"type": "object", "required": ["code", "message"], "additionalProperties": false,
          "properties": {"code": {"type": "string", "minLength": 1}, "message": {"type": "string"}}}
      }
    },
    "execution": {
      "type": "object",
      "required": ["policy", "order", "checkpoint_capture", "fidelity"],
      "additionalProperties": false,
      "properties": {
        "policy": {"const": "exact_first"},
        "order": {"const": "sequential"},
        "checkpoint_capture": {"$ref": "#/$defs/checkpoint_capture"},
        "fidelity": {"enum": ["all_exact", "all_reconstructed", "mixed", "none_completed"]}
      }
    },
    "recorded_alternative": {
      "type": "object",
      "required": ["rank"],
      "additionalProperties": false,
      "properties": {
        "rank": {"type": "integer", "minimum": 0},
        "token_id": {"type": "integer", "minimum": 0},
        "probability": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "reason": {
      "type": "object",
      "required": ["code", "message"],
      "additionalProperties": false,
      "properties": {"code": {"type": "string", "minLength": 1}, "message": {"type": "string"}}
    },
    "exactness": {"type": "object", "additionalProperties": true},
    "comparison": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "state": {"enum": ["available", "trace_unavailable"]},
        "common_prefix_len": {"type": "integer", "minimum": 0},
        "first_divergence": {"type": ["object", "null"]},
        "first_divergence_view": {"type": "object"},
        "surface_similarity": {"type": "object"}
      }
    },
    "branch": {
      "type": "object",
      "required": ["recorded_alternative", "state", "outcome", "reasons", "comparison"],
      "additionalProperties": false,
      "properties": {
        "recorded_alternative": {"$ref": "#/$defs/recorded_alternative"},
        "state": {"enum": ["completed", "unavailable", "not_attempted"]},
        "outcome": {"enum": ["exact_execution_fork", "reconstructed_replay", "unavailable"]},
        "child_run_id": {"type": "string", "minLength": 1},
        "execution_fork_execution_id": {"type": "string", "minLength": 1},
        "exactness": {"$ref": "#/$defs/exactness"},
        "unchanged_control": {
          "type": "object", "required": ["status"], "additionalProperties": true,
          "properties": {"status": {"type": "string", "minLength": 1}}
        },
        "unavoidable_differences": {"type": "array", "items": {"type": "string"}},
        "reasons": {"type": "array", "items": {"$ref": "#/$defs/reason"}},
        "comparison": {"$ref": "#/$defs/comparison"}
      }
    },
    "summary": {
      "type": "object",
      "required": ["status", "requested_branches", "attempted_branches", "children_created", "exact_children", "reconstructed_children", "unavailable_branches", "not_attempted_branches"],
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["completed", "partial", "cancelled", "partial_cancelled", "unavailable"]},
        "requested_branches": {"type": "integer", "minimum": 0},
        "attempted_branches": {"type": "integer", "minimum": 0},
        "children_created": {"type": "integer", "minimum": 0},
        "exact_children": {"type": "integer", "minimum": 0},
        "reconstructed_children": {"type": "integer", "minimum": 0},
        "unavailable_branches": {"type": "integer", "minimum": 0},
        "not_attempted_branches": {"type": "integer", "minimum": 0}
      }
    }
  }
}
