{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clozn.execution-fork.v1",
  "title": "Execution-fork eligibility plan and eventual child receipt",
  "description": "A fail-closed plan for branching an immutable parent run at one recorded response-token boundary. An exact checkpoint reference is compound: checkpoint_id plus worker_generation_id. Once supplied, an unusable exact reference is never silently downgraded to reconstructed text replay. The planned classification describes eligibility, not a completed exactness proof; execution must record the unchanged control and child lineage in a later artifact.",
  "type": "object",
  "oneOf": [
    {
      "required": ["phase"],
      "properties": {"phase": {"const": "planned"}}
    },
    {
      "required": [
        "phase",
        "execution_id",
        "parent_fingerprint_sha256",
        "execution"
      ],
      "properties": {"phase": {"enum": ["completed", "failed", "cancelled"]}}
    }
  ],
  "required": [
    "schema_version",
    "plan_id",
    "phase",
    "classification",
    "parent_run_id",
    "request",
    "identity",
    "exactness",
    "unavoidable_differences",
    "unchanged_control",
    "child_lineage",
    "reasons"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "clozn.execution-fork.v1"},
    "plan_id": {"type": "string", "pattern": "^fork_plan_[0-9a-f]{20}$"},
    "execution_id": {"type": "string", "pattern": "^fork_exec_[0-9a-f]{20}$"},
    "phase": {"enum": ["planned", "completed", "failed", "cancelled"]},
    "classification": {
      "enum": ["exact_execution_fork", "reconstructed_replay", "unavailable"]
    },
    "parent_run_id": {"type": "string", "minLength": 1},
    "parent_fingerprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request": {"$ref": "#/$defs/Request"},
    "checkpoint_reference": {"$ref": "#/$defs/CheckpointReference"},
    "identity": {"$ref": "#/$defs/Identity"},
    "exactness": {"$ref": "#/$defs/Exactness"},
    "unavoidable_differences": {
      "type": "array",
      "items": {
        "enum": [
          "kv_state_not_restored",
          "sampler_state_reinitialized",
          "prompt_prefix_retokenized",
          "batch_shape_not_preserved"
        ]
      }
    },
    "unchanged_control": {"$ref": "#/$defs/UnchangedControl"},
    "child_lineage": {"$ref": "#/$defs/ChildLineage"},
    "execution": {"$ref": "#/$defs/Execution"},
    "reasons": {
      "type": "array",
      "items": {"$ref": "#/$defs/Reason"}
    }
  },
  "$defs": {
    "Request": {
      "type": "object",
      "required": ["position", "change", "change_sha256"],
      "additionalProperties": false,
      "properties": {
        "position": {
          "type": "integer",
          "minimum": 0,
          "description": "Zero-based index of the parent response token to replace or intervene before."
        },
        "change": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {"type": "string", "minLength": 1}
          },
          "description": "The literal requested change. Unsupported shapes remain visible on unavailable plans; execution_change is present only after validation."
        },
        "execution_change": {"$ref": "#/$defs/ExecutionChange"},
        "change_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "ExecutionChange": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "none"}
          }
        },
        {
          "type": "object",
          "required": ["type", "token_id"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "force_token"},
            "token_id": {"type": "integer", "minimum": 0},
            "token_piece": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "required": ["type", "token_piece"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "force_token"},
            "token_piece": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "sampling"},
            "temperature": {"type": "number", "minimum": 0},
            "top_k": {"type": "integer", "minimum": 0},
            "top_p": {"type": "number", "minimum": 0, "maximum": 1},
            "seed": {"type": "integer", "minimum": 0},
            "rep_penalty": {"type": "number", "minimum": 0}
          }
        },
        {
          "type": "object",
          "required": ["type", "clear"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "steer"},
            "clear": {"const": true}
          }
        },
        {
          "type": "object",
          "required": ["type", "steer_vec"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "steer"},
            "steer_vec": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "number"}
            },
            "steer_layer": {"type": "integer", "minimum": 0},
            "steer_coef": {"type": "number"}
          }
        },
        {
          "type": "object",
          "required": ["type", "layer", "position", "values"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "residual_write"},
            "layer": {"type": "integer", "minimum": 1},
            "position": {"type": "integer", "minimum": 0},
            "values": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "number"}
            }
          }
        }
      ]
    },
    "CheckpointReference": {
      "type": "object",
      "required": [
        "checkpoint_id",
        "worker_generation_id",
        "state",
        "parent_run_id"
      ],
      "additionalProperties": false,
      "properties": {
        "checkpoint_id": {"type": "string", "minLength": 1},
        "worker_generation_id": {"type": "string", "minLength": 1},
        "state": {"enum": ["available", "missing", "expired"]},
        "parent_run_id": {"type": "string", "minLength": 1},
        "prompt_tokens": {"type": "integer", "minimum": 0},
        "n_past": {"type": "integer", "minimum": 0},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "RuntimeIdentity": {
      "type": "object",
      "required": [
        "runtime_key_sha256",
        "model_sha256",
        "template_fingerprint",
        "engine_build",
        "context_size",
        "backend",
        "adapter",
        "white_box_flags"
      ],
      "additionalProperties": false,
      "properties": {
        "runtime_key_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 of the other closed runtime fields in this object: GGUF, template, engine, context, backend, full adapter identity, and white-box flags."
        },
        "model_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "template_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{16,64}$"},
        "engine_build": {"type": "string", "minLength": 1},
        "context_size": {"type": "integer", "minimum": 1},
        "backend": {"type": "string", "minLength": 1},
        "adapter": {
          "oneOf": [
            {
              "type": "object",
              "required": ["present", "identity_sha256", "artifact_sha256", "scale"],
              "additionalProperties": false,
              "properties": {
                "present": {"const": false},
                "identity_sha256": {"type": "null"},
                "artifact_sha256": {"type": "null"},
                "scale": {"type": "null"}
              }
            },
            {
              "type": "object",
              "required": ["present", "identity_sha256", "artifact_sha256", "scale"],
              "additionalProperties": false,
              "properties": {
                "present": {"const": true},
                "identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "scale": {"type": "number"}
              }
            }
          ]
        },
        "white_box_flags": {
          "type": "object",
          "additionalProperties": {"type": "boolean"}
        }
      }
    },
    "WorkerIdentity": {
      "type": "object",
      "required": ["worker_id", "worker_generation_id", "protocol_version"],
      "additionalProperties": false,
      "properties": {
        "worker_id": {"type": "string", "minLength": 1},
        "worker_generation_id": {"type": "string", "minLength": 1},
        "protocol_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"}
      }
    },
    "Identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parent_runtime": {"$ref": "#/$defs/RuntimeIdentity"},
        "selected_runtime": {"$ref": "#/$defs/RuntimeIdentity"},
        "selected_worker": {"$ref": "#/$defs/WorkerIdentity"}
      }
    },
    "Exactness": {
      "type": "object",
      "required": ["regime", "source", "proof_status"],
      "additionalProperties": false,
      "properties": {
        "regime": {
          "enum": [
            "generated_token_live_kv",
            "prompt_boundary_reprefill",
            "reconstructed_text",
            "unavailable"
          ]
        },
        "source": {"enum": ["live_kv", "reprefill", "text_retokenization", "unavailable"]},
        "proof_status": {"enum": ["planned", "confirmed", "failed", "not_applicable"]},
        "truncate_to": {"type": "integer", "minimum": 1},
        "boundary_shape_true": {"type": "boolean"}
      }
    },
    "UnchangedControl": {
      "type": "object",
      "required": ["required", "status"],
      "additionalProperties": false,
      "properties": {
        "required": {"const": true},
        "status": {
          "enum": [
            "required_not_run",
            "matched",
            "diverged",
            "failed",
            "cancelled",
            "unavailable"
          ]
        },
        "result": {
          "type": "object",
          "required": ["status", "exact_match"],
          "additionalProperties": false,
          "properties": {
            "status": {"enum": ["matched", "diverged", "failed", "cancelled"]},
            "exact_match": {"type": "boolean"},
            "control_run_id": {"type": "string", "minLength": 1},
            "parent_suffix_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "control_suffix_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "note": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "ChildLineage": {
      "type": "object",
      "required": [
        "parent_run_id",
        "source",
        "change_sha256",
        "receipt_status"
      ],
      "additionalProperties": false,
      "properties": {
        "parent_run_id": {"type": "string", "minLength": 1},
        "child_run_id": {"type": "string", "minLength": 1},
        "source": {"const": "fork"},
        "change_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "receipt_status": {"enum": ["not_created", "created", "failed", "cancelled"]}
      }
    },
    "WorkerReceipt": {
      "type": "object",
      "required": [
        "worker_generation_id",
        "restore_mode",
        "exactness_source",
        "boundary_shape_true",
        "n_past_restored",
        "token_count",
        "token_ids_sha256",
        "text_sha256",
        "intervention_type",
        "intervention_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "worker_generation_id": {"type": "string", "minLength": 1},
        "restore_mode": {"enum": ["live_kv_truncated", "reprefill"]},
        "exactness_source": {"enum": ["live_kv", "reprefill"]},
        "boundary_shape_true": {"const": true},
        "n_past_restored": {"type": "integer", "minimum": 1},
        "token_count": {"type": "integer", "minimum": 0},
        "token_ids_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "intervention_type": {
          "enum": ["none", "force_token", "sampling", "steer", "residual_write"]
        },
        "intervention_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "finish_reason": {"type": "string", "minLength": 1},
        "sampler_source": {"type": "string", "minLength": 1},
        "steer_source": {"type": "string", "minLength": 1}
      }
    },
    "ExecutionError": {
      "type": "object",
      "required": ["stage", "code", "message"],
      "additionalProperties": false,
      "properties": {
        "stage": {"enum": ["precondition", "control", "intervention", "persistence"]},
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1}
      }
    },
    "Execution": {
      "type": "object",
      "required": ["status", "started_ts", "ended_ts"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "succeeded",
            "control_diverged",
            "control_failed",
            "intervention_failed",
            "cancelled",
            "persistence_failed"
          ]
        },
        "started_ts": {"type": "number", "minimum": 0},
        "ended_ts": {"type": "number", "minimum": 0},
        "control": {"$ref": "#/$defs/WorkerReceipt"},
        "intervention": {"$ref": "#/$defs/WorkerReceipt"},
        "error": {"$ref": "#/$defs/ExecutionError"}
      }
    },
    "Reason": {
      "type": "object",
      "required": ["code", "message"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "exact_preconditions_met",
            "checkpoint_not_supplied",
            "invalid_parent_run",
            "missing_response_token_boundary",
            "position_out_of_range",
            "unsupported_intervention",
            "invalid_intervention",
            "reconstruction_unsupported_intervention",
            "reconstruction_prompt_unavailable",
            "reconstruction_token_piece_unavailable",
            "checkpoint_missing",
            "checkpoint_expired",
            "checkpoint_parent_mismatch",
            "stale_worker_generation",
            "worker_identity_unavailable",
            "runtime_identity_unavailable",
            "runtime_identity_mismatch",
            "missing_prompt_boundary",
            "checkpoint_range_mismatch",
            "execution_succeeded",
            "control_diverged",
            "control_failed",
            "intervention_failed",
            "execution_cancelled",
            "persistence_failed",
            "stale_plan"
          ]
        },
        "message": {"type": "string", "minLength": 1}
      }
    }
  }
}
