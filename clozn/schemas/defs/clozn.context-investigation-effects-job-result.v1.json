{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clozn.context-investigation-effects-job-result.v1",
  "title": "Compact Context Investigation effects job result",
  "type": "object",
  "required": [
    "schema_version",
    "experiment_id",
    "source_count",
    "completed_source_count",
    "unavailable_source_count",
    "failed_source_count",
    "not_measured_source_count",
    "executed_score_count",
    "reused_score_count",
    "elapsed_seconds",
    "scoring_mode",
    "evidence_quality",
    "execution_strategy",
    "numerical_regime",
    "state"
  ],
  "properties": {
    "schema_version": {"const": "clozn.context-investigation-effects-job-result.v1"},
    "experiment_id": {"type": "string", "minLength": 1},
    "source_count": {"type": "integer", "minimum": 0},
    "completed_source_count": {"type": "integer", "minimum": 0},
    "unavailable_source_count": {"type": "integer", "minimum": 0},
    "failed_source_count": {"type": "integer", "minimum": 0},
    "not_measured_source_count": {"type": "integer", "minimum": 0},
    "executed_score_count": {"type": "integer", "minimum": 0},
    "reused_score_count": {"type": "integer", "minimum": 0},
    "elapsed_seconds": {"type": "number", "minimum": 0},
    "scoring_mode": {"enum": ["fast", "exact"]},
    "evidence_quality": {"enum": ["approximate", "exact"]},
    "execution_strategy": {"type": "string", "minLength": 1},
    "numerical_regime": {"type": "string", "minLength": 1},
    "timing_detail": {"type": "object"},
    "batching": {
      "type": "object",
      "required": [
        "requested_sequence_batch_size",
        "batch_count",
        "arm_batch_sizes",
        "sequence_batch_sizes",
        "control_batched"
      ],
      "properties": {
        "requested_sequence_batch_size": {"type": ["integer", "null"], "minimum": 1},
        "batch_count": {"type": "integer", "minimum": 0},
        "arm_batch_sizes": {
          "type": "array",
          "items": {"type": "integer", "minimum": 0}
        },
        "sequence_batch_sizes": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1}
        },
        "control_batched": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "execution_plan": {
      "type": "object",
      "required": [
        "policy",
        "selected_strategy",
        "reason",
        "prompt_tokens",
        "continuation_tokens",
        "sequence_count",
        "native_sequence_batch_size"
      ],
      "properties": {
        "policy": {"const": "clozn.fast-path-auto.v1"},
        "selected_strategy": {"enum": ["native_prefix_trie", "scalar_prefix_cache"]},
        "reason": {"type": "string", "minLength": 1},
        "prompt_tokens": {"type": ["integer", "null"], "minimum": 1},
        "continuation_tokens": {"type": ["integer", "null"], "minimum": 1},
        "sequence_count": {"type": "integer", "minimum": 1},
        "native_sequence_batch_size": {"type": "integer", "minimum": 1, "maximum": 16}
      },
      "additionalProperties": false
    },
    "state": {"type": "string"}
  }
}
