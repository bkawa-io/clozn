{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clozn.context-investigation-remove-test-result.v1",
  "title": "Compact Context Investigation remove-test result",
  "type": "object",
  "required": ["schema_version", "run_id", "source_id", "experiment_id", "arm_id", "status", "experiment_state"],
  "properties": {
    "schema_version": {"const": "clozn.context-investigation-remove-test-result.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "experiment_id": {"type": "string", "minLength": 1},
    "arm_id": {"type": "string", "minLength": 1},
    "observation_id": {"type": ["string", "null"]},
    "status": {"type": "string"},
    "matched_token_count": {"type": ["integer", "null"], "minimum": 0},
    "first_divergence_index": {"type": ["integer", "null"], "minimum": 0},
    "divergence_kind": {"type": ["string", "null"]},
    "reason": {"type": ["string", "null"]},
    "reason_code": {"type": ["string", "null"]},
    "experiment_state": {"type": "string"}
  }
}
