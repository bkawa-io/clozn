{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clozn.adapter-export-receipt.v1",
  "title": "Clozn adapter merged-export equivalence receipt",
  "description": "A local, three-arm base/base-plus-adapter/merged export validation receipt. Unknown additive fields are retained for forward compatibility.",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_id",
    "created_at",
    "producer",
    "suite",
    "inputs",
    "preflight",
    "cases",
    "summary",
    "verdict",
    "claims"
  ],
  "properties": {
    "schema_version": {
      "const": "clozn.adapter-export-receipt.v1"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "minLength": 1
    },
    "producer": {
      "type": "object",
      "required": ["clozn_version"],
      "properties": {
        "clozn_version": {
          "type": "string",
          "minLength": 1
        },
        "engine": {
          "$ref": "#/$defs/engineIdentity"
        }
      }
    },
    "suite": {
      "type": "object",
      "required": ["suite_id", "sha256", "case_count", "expanded_case_count"],
      "properties": {
        "suite_id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "case_count": {
          "type": "integer",
          "minimum": 1
        },
        "expanded_case_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "inputs": {
      "type": "object",
      "required": ["base", "adapter", "merged"],
      "properties": {
        "base": {
          "$ref": "#/$defs/modelIdentity"
        },
        "adapter": {
          "$ref": "#/$defs/adapterIdentity"
        },
        "merged": {
          "$ref": "#/$defs/modelIdentity"
        }
      }
    },
    "preflight": {
      "type": "object",
      "required": ["status", "checks"],
      "properties": {
        "status": {
          "enum": ["passed", "failed"]
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/preflightCheck"
          }
        },
        "effective_identity": {
          "type": "object",
          "properties": {
            "base": {
              "$ref": "#/$defs/effectiveArm"
            },
            "adapted": {
              "$ref": "#/$defs/effectiveArm"
            },
            "merged": {
              "$ref": "#/$defs/effectiveArm"
            }
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/caseResult"
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "expanded_case_count",
        "completed",
        "passed",
        "mismatched",
        "inconclusive",
        "execution_errors",
        "teacher_forced_tokens"
      ],
      "properties": {
        "expanded_case_count": {
          "type": "integer",
          "minimum": 1
        },
        "completed": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "mismatched": {
          "type": "integer",
          "minimum": 0
        },
        "inconclusive": {
          "type": "integer",
          "minimum": 0
        },
        "execution_errors": {
          "type": "integer",
          "minimum": 0
        },
        "teacher_forced_tokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "verdict": {
      "type": "object",
      "required": ["status", "reason"],
      "properties": {
        "status": {
          "enum": [
            "equivalent_within_budget",
            "behavioral_mismatch",
            "identity_mismatch",
            "execution_error",
            "inconclusive"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "claims": {
      "type": "object",
      "required": [
        "primary_comparison",
        "base_role",
        "byte_equivalent",
        "semantic_equivalence_proven"
      ],
      "properties": {
        "primary_comparison": {
          "const": "base_plus_adapter_vs_merged"
        },
        "base_role": {
          "const": "control"
        },
        "byte_equivalent": {
          "const": false
        },
        "semantic_equivalence_proven": {
          "const": false
        },
        "quantization_note": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "modelIdentity": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "file_size",
        "architecture",
        "vocab_size",
        "tokenizer_sha256",
        "chat_template_sha256",
        "quantization"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "file_size": {
          "type": "integer",
          "minimum": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "hidden_size": {
          "type": "integer",
          "minimum": 1
        },
        "layer_count": {
          "type": "integer",
          "minimum": 1
        },
        "vocab_size": {
          "type": "integer",
          "minimum": 1
        },
        "tokenizer_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "chat_template_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "quantization": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "adapterIdentity": {
      "type": "object",
      "required": ["path", "sha256", "file_size", "format"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "file_size": {
          "type": "integer",
          "minimum": 1
        },
        "format": {
          "enum": ["lora_gguf", "unsupported_gguf"]
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "engineIdentity": {
      "type": "object",
      "required": ["entrypoint", "entrypoint_sha256", "discovery_source", "backend"],
      "properties": {
        "entrypoint": {
          "type": "string",
          "minLength": 1
        },
        "entrypoint_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "discovery_source": {
          "type": "string",
          "minLength": 1
        },
        "backend": {
          "type": "string",
          "minLength": 1
        },
        "engine_version": {
          "type": "string",
          "minLength": 1
        },
        "build_id": {
          "type": "string",
          "minLength": 1
        },
        "llama_cpp_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "preflightCheck": {
      "type": "object",
      "required": ["name", "status", "detail"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["passed", "failed"]
        },
        "detail": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "effectiveArm": {
      "type": "object",
      "required": ["model_sha256", "protocol_version"],
      "properties": {
        "model_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "protocol_version": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "device": {
          "type": "string",
          "minLength": 1
        },
        "adapter": {
          "type": "object",
          "required": ["path", "scale"],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "scale": {
              "type": "number"
            },
            "metadata": {
              "type": "object"
            }
          }
        }
      }
    },
    "assertion": {
      "type": "object",
      "required": ["name", "passed", "observed", "budget"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "passed": {
          "type": "boolean"
        },
        "observed": {
          "type": "number"
        },
        "budget": {
          "type": "number"
        }
      }
    },
    "deltaPosition": {
      "type": "object",
      "required": ["index", "token_id", "delta_nats", "status"],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "token_id": {
          "type": "integer"
        },
        "delta_nats": {
          "type": "number"
        },
        "status": {
          "enum": ["preserved", "flipped", "unknown"]
        },
        "argmax_a_id": {
          "type": "integer"
        },
        "argmax_b_id": {
          "type": "integer"
        }
      }
    },
    "teacherForcedDelta": {
      "type": "object",
      "required": [
        "causal_verified",
        "n_tokens",
        "n_flipped",
        "n_preserved",
        "n_unknown",
        "mean_abs_delta_nats",
        "positions"
      ],
      "properties": {
        "causal_verified": {
          "const": true
        },
        "n_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "n_flipped": {
          "type": "integer",
          "minimum": 0
        },
        "n_preserved": {
          "type": "integer",
          "minimum": 0
        },
        "n_unknown": {
          "type": "integer",
          "minimum": 0
        },
        "mean_abs_delta_nats": {
          "type": "number",
          "minimum": 0
        },
        "positions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/deltaPosition"
          }
        }
      }
    },
    "caseResult": {
      "type": "object",
      "required": [
        "case_id",
        "seed",
        "status",
        "messages_sha256",
        "run_ids"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "seed": {
          "type": "integer"
        },
        "status": {
          "enum": ["passed", "behavioral_mismatch", "identity_mismatch", "execution_error", "inconclusive"]
        },
        "messages_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "continuation_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "run_ids": {
          "type": "object",
          "required": ["base", "adapted", "merged"],
          "properties": {
            "base": {
              "type": "string",
              "minLength": 1
            },
            "adapted": {
              "type": "string",
              "minLength": 1
            },
            "merged": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "teacher_forced": {
          "type": "object",
          "required": ["base_vs_adapted", "adapted_vs_merged"],
          "properties": {
            "base_vs_adapted": {
              "$ref": "#/$defs/teacherForcedDelta"
            },
            "adapted_vs_merged": {
              "$ref": "#/$defs/teacherForcedDelta"
            }
          }
        },
        "assertions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assertion"
          }
        },
        "error": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
