{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clozn.model-routing.v1",
  "title": "Single-worker model selection receipt",
  "type": "object",
  "required": ["schema_version", "protocol", "request", "policy", "result"],
  "properties": {
    "schema_version": {"const": "clozn.model-routing.v1"},
    "protocol": {
      "type": "object",
      "required": ["surface", "route"],
      "properties": {
        "surface": {"enum": ["openai", "native"]},
        "route": {"type": "string", "minLength": 1}
      }
    },
    "request": {
      "type": "object",
      "required": ["request_id", "requested_model", "selection_source"],
      "properties": {
        "request_id": {"type": "string", "minLength": 1},
        "requested_model": {"type": ["string", "null"]},
        "selection_source": {"enum": ["explicit", "default"]}
      }
    },
    "policy": {
      "type": "object",
      "required": ["configured_model_id", "omitted_model_policy", "unknown_model_policy"],
      "properties": {
        "configured_model_id": {"type": "string", "minLength": 1},
        "omitted_model_policy": {"const": "configured_model"},
        "unknown_model_policy": {"const": "error_no_fallback"}
      }
    },
    "result": {
      "oneOf": [
        {
          "type": "object",
          "required": ["status", "lifecycle_state", "receipt"],
          "properties": {
            "status": {"const": "routed"},
            "lifecycle_state": {"const": "ready"},
            "receipt": {"$ref": "#/$defs/Receipt"}
          }
        },
        {
          "type": "object",
          "required": ["status", "lifecycle_state", "error"],
          "properties": {
            "status": {"const": "error"},
            "lifecycle_state": {"enum": ["ready", "failed"]},
            "error": {"$ref": "#/$defs/Error"}
          }
        }
      ]
    }
  },
  "$defs": {
    "RuntimeKey": {
      "type": "object",
      "required": ["key_sha256", "gguf_artifact_sha256", "context_size", "backend", "template_fingerprint", "engine_build"],
      "properties": {
        "key_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "gguf_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "context_size": {"type": "integer", "minimum": 1},
        "backend": {"type": "string", "minLength": 1},
        "template_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{16,64}$"},
        "engine_build": {"type": "string", "minLength": 1}
      }
    },
    "WorkerIdentity": {
      "type": "object",
      "required": ["worker_id", "worker_generation_id", "worker_generation", "runtime_key_sha256", "protocol_version", "engine_build", "backend"],
      "properties": {
        "worker_id": {"type": "string", "minLength": 1},
        "worker_generation_id": {"type": "string", "minLength": 1},
        "worker_generation": {"type": "integer", "minimum": 1},
        "runtime_key_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "protocol_version": {"type": "string", "minLength": 1},
        "engine_build": {"type": "string", "minLength": 1},
        "backend": {"type": "string", "minLength": 1}
      }
    },
    "Receipt": {
      "type": "object",
      "required": ["requested_model", "selection_source", "resolved_model_id", "resolved_artifact", "runtime_key", "worker_identity"],
      "properties": {
        "requested_model": {"type": ["string", "null"]},
        "selection_source": {"enum": ["explicit", "default"]},
        "resolved_model_id": {"type": "string", "minLength": 1},
        "resolved_artifact": {
          "type": "object",
          "required": ["model_id", "format", "artifact_sha256"],
          "properties": {
            "model_id": {"type": "string", "minLength": 1},
            "format": {"const": "gguf"},
            "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "runtime_key": {"$ref": "#/$defs/RuntimeKey"},
        "worker_identity": {"$ref": "#/$defs/WorkerIdentity"}
      }
    },
    "Error": {
      "type": "object",
      "required": ["code", "http_status", "retryable", "phase", "message"],
      "properties": {
        "code": {"enum": ["invalid_model_selection", "unknown_model", "generation_queue_full", "queue_timeout", "request_cancelled", "worker_failed", "worker_identity_mismatch"]},
        "http_status": {"type": "integer", "minimum": 400},
        "retryable": {"type": "boolean"},
        "phase": {"enum": ["selection", "resolution", "generation_queue", "request", "generation", "handshake"]},
        "message": {"type": "string", "minLength": 1}
      }
    }
  }
}
