{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clozn.time-machine-branch.v1",
  "title": "Answer Time Machine exact child replay",
  "description": "A terminal receipt for an explicit same-prompt child replay from a verified prompt-boundary checkpoint. An alternate question is not an exact child replay and must use the structural branch path.",
  "type": "object",
  "required": [
    "schema_version",
    "requested_run_id",
    "source_turn",
    "status",
    "exact_replay",
    "fidelity",
    "reasons",
    "capture",
    "execution_fork"
  ],
  "oneOf": [
    {
      "required": ["status", "source_run_id", "child_run_id", "execution_fork_execution_id"],
      "properties": {"status": {"const": "completed"}}
    },
    {
      "required": ["status", "source_run_id", "execution_fork_execution_id"],
      "properties": {"status": {"const": "failed"}}
    },
    {
      "required": ["status"],
      "properties": {"status": {"const": "unavailable"}}
    }
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "clozn.time-machine-branch.v1"},
    "requested_run_id": {"type": "string", "minLength": 1},
    "source_run_id": {"type": "string", "minLength": 1},
    "source_turn": {"type": "integer", "minimum": 0},
    "status": {"enum": ["completed", "unavailable", "failed"]},
    "exact_replay": {"type": "boolean"},
    "fidelity": {"enum": ["exact_replay_eligible", "unavailable"]},
    "child_run_id": {"type": "string", "minLength": 1},
    "execution_fork_execution_id": {"type": "string", "minLength": 1},
    "reasons": {"type": "array", "items": {"$ref": "#/$defs/Reason"}},
    "capture": {"type": "object", "additionalProperties": true},
    "execution_fork": {"type": "object", "additionalProperties": true}
  },
  "$defs": {
    "Reason": {
      "type": "object",
      "required": ["code", "message"],
      "additionalProperties": false,
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1}
      }
    }
  }
}
