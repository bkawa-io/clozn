{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clozn.minimal-context-eval.v1",
  "title": "Realistic recorded-trace minimal-context evaluation report",
  "description": "A prompt-free projection of bounded exact-reference evaluations over ordinary recorded Clozn runs.",
  "type": "object",
  "required": ["schema_version", "cases", "suite_summary"],
  "properties": {
    "schema_version": {"const": "clozn.minimal-context-eval.v1"},
    "cases": {"type": "array", "items": {"type": "object"}},
    "suite_summary": {"type": "object"}
  },
  "additionalProperties": false
}
