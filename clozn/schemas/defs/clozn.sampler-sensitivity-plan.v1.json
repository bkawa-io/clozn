{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clozn.sampler-sensitivity-plan.v1",
  "title": "Clozn Sampler Sensitivity plan",
  "description": "A deterministic, read-only exact sampler probe plan. It defines a bounded nearby neighborhood and never claims live exactness before execution.",
  "type": "object",
  "required": ["schema_version", "test_id", "run_id", "parent_fingerprint_sha256", "position", "seed_probes", "baseline_sampler", "recipe", "probes", "execution"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "clozn.sampler-sensitivity-plan.v1"},
    "test_id": {"type": "string", "pattern": "^sampler_sensitivity_[0-9a-f]{24}$"},
    "run_id": {"type": "string", "minLength": 1},
    "parent_fingerprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "position": {"type": "integer", "minimum": 0},
    "seed_probes": {"type": "integer", "minimum": 0, "maximum": 2},
    "baseline_sampler": {"$ref": "#/$defs/baseline_sampler"},
    "recipe": {"$ref": "#/$defs/recipe"},
    "probes": {"type": "array", "items": {"$ref": "#/$defs/probe"}},
    "execution": {"$ref": "#/$defs/execution"}
  },
  "$defs": {
    "baseline_sampler": {
      "type": "object",
      "required": ["mode"],
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["sample", "greedy", "unavailable"]},
        "temperature": {"type": ["number", "null"]},
        "top_p": {"type": ["number", "null"]},
        "top_k": {"type": ["integer", "null"]},
        "rep_penalty": {"type": ["number", "null"]},
        "seed": {"type": ["integer", "null"]}
      }
    },
    "recipe": {
      "type": "object",
      "required": ["id", "temperature_multiplier_down", "temperature_multiplier_up", "top_p_delta"],
      "additionalProperties": false,
      "properties": {
        "id": {"const": "nearby_v1"},
        "temperature_multiplier_down": {"const": 0.8},
        "temperature_multiplier_up": {"const": 1.2},
        "top_p_delta": {"const": 0.05}
      }
    },
    "change": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "sampling"},
        "temperature": {"type": "number", "minimum": 0},
        "top_p": {"type": "number", "minimum": 0, "maximum": 1},
        "seed": {"type": "integer", "minimum": 0}
      },
      "description": "Exactly one sampler field is present in each generated change; the planner enforces this invariant."
    },
    "probe": {
      "type": "object",
      "required": ["probe_id", "kind", "axis", "change"],
      "additionalProperties": false,
      "properties": {
        "probe_id": {"type": "string", "pattern": "^sampler_probe_[0-9a-f]{24}$"},
        "kind": {"enum": ["parameter", "seed"]},
        "axis": {"enum": ["temperature", "top_p", "seed"]},
        "direction": {"enum": ["down", "up", "alternate"]},
        "ordinal": {"type": "integer", "minimum": 0},
        "change": {"$ref": "#/$defs/change"}
      }
    },
    "reason": {
      "type": "object",
      "required": ["code", "message"],
      "additionalProperties": false,
      "properties": {"code": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}}
    },
    "execution": {
      "type": "object",
      "required": ["state", "fidelity", "live_state"],
      "additionalProperties": false,
      "properties": {
        "state": {"enum": ["ready", "unavailable"]},
        "fidelity": {"const": "exact_required"},
        "live_state": {"const": "not_checked"},
        "reason": {"type": "string", "minLength": 1},
        "reasons": {"type": "array", "items": {"$ref": "#/$defs/reason"}}
      }
    }
  }
}
