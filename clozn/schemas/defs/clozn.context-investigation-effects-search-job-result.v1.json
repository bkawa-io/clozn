{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clozn.context-investigation-effects-search-job-result.v1",
  "title": "Context Investigation coarse-to-fine effects-search job result",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "source_ids",
    "refine_threshold_nats",
    "budget",
    "budget_usage",
    "native_screening_requested",
    "coverage",
    "arms",
    "experiments",
    "search_spec",
    "reader_projection"
  ],
  "properties": {
    "schema_version": {
      "const": "clozn.context-investigation-effects-search-job-result.v1"
    },
    "run_id": {"type": "string", "minLength": 1},
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "refine_threshold_nats": {"type": "number", "minimum": 0},
    "budget": {"$ref": "#/$defs/budget"},
    "budget_usage": {
      "type": "object",
      "required": [
        "limits",
        "new_slots_reserved_before_cancellation",
        "cache_or_prior_hits",
        "exhausted",
        "control_outside_intervention_budget",
        "actual_work"
      ],
      "properties": {
        "limits": {"$ref": "#/$defs/budget"},
        "new_slots_reserved_before_cancellation": {"type": "object"},
        "cache_or_prior_hits": {"type": "object"},
        "exhausted": {"type": "object"},
        "control_outside_intervention_budget": {"type": "boolean"},
        "actual_work": {
          "type": "object",
          "required": [
            "control",
            "interventions",
            "model_measurements_executed_total",
            "model_measurements_reused_total",
            "model_measurements_skipped_total",
            "saved_model_measurements_total",
            "saved_work_breakdown"
          ]
        }
      }
    },
    "native_screening_requested": {"type": "boolean"},
    "coverage": {"type": "object"},
    "arms": {
      "type": "array",
      "items": {"$ref": "#/$defs/arm"}
    },
    "experiments": {
      "type": "object",
      "required": ["coarse_experiment_id", "refinement_experiment_id"],
      "properties": {
        "coarse_experiment_id": {"type": "string", "minLength": 1},
        "refinement_experiment_id": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "search_spec": {"$ref": "#/$defs/search_spec"},
    "reader_projection": {
      "type": "object",
      "required": [
        "experiment_id",
        "status",
        "control_observation_id",
        "trusted_singleton_source_ids"
      ],
      "properties": {
        "experiment_id": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "control_observation_id": {"type": ["string", "null"]},
        "trusted_singleton_source_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "budget": {
      "type": "object",
      "required": ["max_coarse_arms", "max_fine_arms", "max_joint_arms"],
      "properties": {
        "max_coarse_arms": {"type": "integer", "minimum": 0},
        "max_fine_arms": {"type": "integer", "minimum": 0},
        "max_joint_arms": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "source_set": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "arm": {
      "type": "object",
      "required": [
        "phase",
        "source_ids",
        "selection_reason",
        "execution_state",
        "execution_disposition",
        "evidence_status",
        "delta_nats",
        "observation_id",
        "proof_grade",
        "reused_from_phase",
        "numerical_regime",
        "execution_identity",
        "diagnostics"
      ],
      "properties": {
        "phase": {"enum": ["coarse", "fine", "joint"]},
        "source_ids": {"$ref": "#/$defs/source_set"},
        "selection_reason": {"type": "string", "minLength": 1},
        "execution_state": {"type": "string", "minLength": 1},
        "execution_disposition": {"type": "string", "minLength": 1},
        "evidence_status": {
          "enum": ["trusted", "screening_only", "unavailable", "skipped"]
        },
        "delta_nats": {"type": ["number", "null"]},
        "observation_id": {"type": ["string", "null"]},
        "proof_grade": {"type": ["string", "null"]},
        "reused_from_phase": {"type": ["string", "null"]},
        "numerical_regime": {"type": ["string", "null"], "minLength": 1},
        "execution_identity": {"type": ["object", "null"]},
        "diagnostics": {"type": "object"}
      },
      "additionalProperties": false
    },
    "search_spec": {
      "type": "object",
      "required": [
        "source_ids",
        "coarse_groups",
        "coarse_group_size",
        "refine_threshold_nats",
        "drilldown_source_ids",
        "joint_source_sets",
        "budget",
        "execution_policy"
      ],
      "properties": {
        "source_ids": {"$ref": "#/$defs/source_set"},
        "coarse_groups": {
          "type": "array",
          "items": {"$ref": "#/$defs/source_set"}
        },
        "coarse_group_size": {"type": ["integer", "null"], "minimum": 1},
        "refine_threshold_nats": {"type": "number", "minimum": 0},
        "drilldown_source_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "joint_source_sets": {
          "type": "array",
          "items": {"$ref": "#/$defs/source_set"}
        },
        "budget": {"$ref": "#/$defs/budget"},
        "execution_policy": {
          "enum": ["trusted_scalar_only", "native_screen_then_scalar_refine"]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
