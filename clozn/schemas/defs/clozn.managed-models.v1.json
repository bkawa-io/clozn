{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clozn.managed-models.v1",
  "title": "Qualified preloaded model definitions for one managed gateway",
  "description": "Closed CLI input contract for RT-BOOT-01. It configures preloaded workers only: v1 does not authorize cold loading, eviction, aliases, or public worker ports. Cross-field hashes, file existence, executable selection, and live template qualification are additionally validated by the supervisor.",
  "type": "object",
  "required": [
    "schema_version",
    "default_model_id",
    "preload_model_ids",
    "max_loaded_models",
    "models"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "clozn.managed-models.v1"},
    "default_model_id": {"type": "string", "minLength": 1},
    "preload_model_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "max_loaded_models": {"type": "integer", "minimum": 1},
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/Model"}
    }
  },
  "$defs": {
    "AdapterAbsent": {
      "type": "object",
      "required": ["present", "identity_sha256", "artifact_sha256", "scale"],
      "additionalProperties": false,
      "properties": {
        "present": {"const": false},
        "identity_sha256": {"type": "null"},
        "artifact_sha256": {"type": "null"},
        "scale": {"type": "null"}
      }
    },
    "AdapterPresent": {
      "type": "object",
      "required": ["present", "identity_sha256", "artifact_sha256", "scale"],
      "additionalProperties": false,
      "properties": {
        "present": {"const": true},
        "identity_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "scale": {"type": "number"}
      }
    },
    "RuntimeKey": {
      "type": "object",
      "required": [
        "key_sha256",
        "gguf_artifact_sha256",
        "context_size",
        "backend",
        "adapter",
        "template_fingerprint",
        "engine_build",
        "white_box_flags"
      ],
      "additionalProperties": false,
      "properties": {
        "key_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "gguf_artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "context_size": {"type": "integer", "minimum": 1},
        "backend": {"type": "string", "minLength": 1},
        "adapter": {
          "oneOf": [
            {"$ref": "#/$defs/AdapterAbsent"},
            {"$ref": "#/$defs/AdapterPresent"}
          ]
        },
        "template_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "engine_build": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "white_box_flags": {
          "type": "object",
          "required": ["sae", "jlens", "attn_knockout"],
          "additionalProperties": false,
          "properties": {
            "sae": {"type": "boolean"},
            "jlens": {"type": "boolean"},
            "attn_knockout": {"type": "boolean"}
          }
        }
      }
    },
    "Flags": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ctx": {"type": "integer", "minimum": 1},
        "adapter": {"type": "string", "minLength": 1},
        "adapter_scale": {"type": "number"},
        "chat": {"type": "boolean"},
        "tmpl": {"type": "string", "minLength": 1},
        "extra_args": {
          "type": "array",
          "maxItems": 1,
          "items": {"type": "string"}
        }
      }
    },
    "Model": {
      "type": "object",
      "required": ["model_id", "model", "runtime_key"],
      "additionalProperties": false,
      "properties": {
        "model_id": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "runtime_key": {"$ref": "#/$defs/RuntimeKey"},
        "flags": {"$ref": "#/$defs/Flags"},
        "prefer_gpu": {"type": "boolean"},
        "boot_timeout": {"type": "number", "minimum": 0},
        "restart_limit": {"type": "integer", "minimum": 1},
        "restart_window": {"type": "number", "minimum": 0}
      }
    }
  }
}
