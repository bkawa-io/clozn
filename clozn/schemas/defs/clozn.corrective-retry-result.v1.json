{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clozn.corrective-retry-result.v1",
  "title": "Persisted outcome of one confirmed corrective action",
  "description": "A confirmed, one-shot matched greedy comparison. Keeping a corrected child (transaction) only ever selects it as this run's own revision -- durable session/profile scoping was retired, see docs/CAPABILITIES.md. Confirming alone never mutates any standing policy.",
  "type": "object",
  "required": [
    "schema_version",
    "result_id",
    "created_ts",
    "parent_run_id",
    "preview_id",
    "action",
    "user_intent",
    "execution",
    "children",
    "comparison",
    "metrics",
    "scope_eligibility",
    "outcome"
  ],
  "properties": {
    "schema_version": {"const": "clozn.corrective-retry-result.v1"},
    "result_id": {"type": "string", "pattern": "^fix_result_[a-f0-9]{20}$"},
    "created_ts": {"type": "number", "minimum": 0},
    "parent_run_id": {"type": "string", "minLength": 1},
    "preview_id": {"type": "string", "pattern": "^fix_preview_[a-f0-9]{20}$"},
    "action": {
      "type": "object",
      "required": ["id", "label", "description"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "user_intent": {
      "type": "object",
      "required": ["action_id"],
      "properties": {
        "action_id": {"type": "string", "minLength": 1},
        "kept_scope": {"enum": ["once"]}
      }
    },
    "execution": {
      "type": "object",
      "required": ["requested_backend", "executed_backend", "fallback", "qualification", "qualification_id", "identity"],
      "properties": {
        "requested_backend": {"enum": ["prompt_policy", "control_vector"]},
        "executed_backend": {"type": ["string", "null"], "enum": ["prompt_policy", "control_vector", null]},
        "fallback": {"type": "boolean"},
        "qualification": {"type": ["string", "null"]},
        "qualification_id": {"type": ["string", "null"]},
        "identity": {"type": ["object", "null"]}
      }
    },
    "children": {
      "type": "object",
      "required": ["baseline", "corrected"],
      "properties": {
        "baseline": {"$ref": "#/$defs/child"},
        "corrected": {"$ref": "#/$defs/child"}
      }
    },
    "comparison": {
      "type": "object",
      "required": ["stored_original_reply", "baseline_reply", "corrected_reply", "note", "changed"],
      "properties": {
        "stored_original_reply": {"type": "string"},
        "baseline_reply": {"type": "string"},
        "corrected_reply": {"type": "string"},
        "note": {"type": "string"},
        "changed": {"type": "boolean"}
      }
    },
    "metrics": {"type": "object"},
    "coherence": {"type": "object"},
    "intervention_observed": {"type": "boolean"},
    "scope_eligibility": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"$ref": "#/$defs/scope"}
    },
    "outcome": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["succeeded", "execution_error", "cancelled"]},
        "note": {"type": "string"}
      }
    },
    "transaction": {"type": "object"},
    "source_use_comparison": {"type": "object"}
  },
  "$defs": {
    "child": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["success", "error", "not_run"]},
        "run_id": {"type": ["string", "null"]},
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": {"type": "string", "minLength": 1},
            "message": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "required": ["scope", "available"],
      "properties": {
        "scope": {"enum": ["once"]},
        "available": {"type": "boolean"},
        "target": {"type": "string"},
        "prior_hash": {"type": "string"},
        "before": {"type": "array", "items": {"type": "string"}},
        "after": {"type": "array", "items": {"type": "string"}},
        "note": {"type": "string"},
        "unavailability_reason": {"type": "string"}
      }
    }
  }
}
