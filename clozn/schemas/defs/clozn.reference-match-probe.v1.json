{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clozn.reference-match-probe.v1",
  "title": "Exact recorded-answer reference match probe",
  "description": "A non-journaling direct generation probe comparing committed token IDs and boundary termination. No prompt or answer text is stored.",
  "type": "object",
  "required": ["schema_version", "probe_id", "run_id", "removed_source_ids", "exact_removed_ranges", "basis_digest", "intervened_context_digest", "reference_token_ids_sha256", "reference_token_count", "generation_contract", "result", "provenance"],
  "properties": {
    "schema_version": {"const": "clozn.reference-match-probe.v1"},
    "probe_id": {"type": "string", "pattern": "^rmp_[0-9a-f]{24}$"},
    "run_id": {"type": "string", "minLength": 1},
    "removed_source_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source_id"}},
    "exact_removed_ranges": {"type": "array", "items": {"type": "object", "required": ["source_id", "message_index", "unicode_range", "byte_range", "content_sha256", "source_kind"], "properties": {"source_id": {"$ref": "#/$defs/source_id"}, "message_index": {"type": "integer", "minimum": 0}, "unicode_range": {"$ref": "#/$defs/range"}, "byte_range": {"$ref": "#/$defs/range"}, "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "source_kind": {"type": "string", "minLength": 1}}, "additionalProperties": true}},
    "basis_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "intervened_context_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reference_token_ids_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reference_token_count": {"type": "integer", "minimum": 1},
    "generation_contract": {"$ref": "#/$defs/generation_contract"},
    "result": {"$ref": "#/$defs/result"},
    "provenance": {"const": "direct_generation_probe"}
  },
  "additionalProperties": false,
  "$defs": {
    "source_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.:-]+$"},
    "range": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 0}},
    "generation_contract": {
      "type": "object",
      "required": ["decode_mode", "sampling", "max_new", "stop", "expected_termination"],
      "properties": {
        "decode_mode": {"enum": ["greedy", "sample"]},
        "sampling": {"type": ["object", "null"]},
        "max_new": {"type": "integer", "minimum": 1},
        "stop": {"type": "array", "items": {"type": "string"}},
        "expected_termination": {"type": "object", "required": ["reason", "reason_raw"], "properties": {"reason": {"type": "string", "minLength": 1}, "reason_raw": {"type": "string", "minLength": 1}}, "additionalProperties": false}
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"enum": ["matched", "diverged", "unavailable"]},
        "reason": {"type": "string", "minLength": 1},
        "matched_token_count": {"type": "integer", "minimum": 0},
        "first_divergence_index": {"type": ["integer", "null"], "minimum": 0},
        "expected_token_id": {"type": ["integer", "null"]},
        "actual_token_id": {"type": ["integer", "null"]},
        "termination_match": {"type": "boolean"},
        "termination": {"type": "object"},
        "finish_reason": {"type": ["string", "null"]},
        "divergence_kind": {"enum": ["token_mismatch", "early_termination", "extra_token_after_reference", "termination_mismatch", null]}
      },
      "additionalProperties": false
    }
  }
}
