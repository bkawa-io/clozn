{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clozn.context-investigation-effects-search-job-request.v1",
  "title": "Context Investigation coarse-to-fine effects-search job request",
  "type": "object",
  "required": ["budget", "execution_policy"],
  "properties": {
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"type": "string", "minLength": 1}
    },
    "coarse_groups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 64,
        "items": {"type": "string", "minLength": 1}
      }
    },
    "coarse_group_size": {"type": "integer", "minimum": 1, "maximum": 64},
    "refine_threshold_nats": {"type": "number", "minimum": 0},
    "drilldown_source_ids": {
      "type": "array",
      "maxItems": 256,
      "items": {"type": "string", "minLength": 1}
    },
    "joint_source_sets": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 64,
        "items": {"type": "string", "minLength": 1}
      }
    },
    "budget": {
      "type": "object",
      "required": ["max_coarse_arms", "max_fine_arms", "max_joint_arms"],
      "properties": {
        "max_coarse_arms": {"type": "integer", "minimum": 0, "maximum": 256},
        "max_fine_arms": {"type": "integer", "minimum": 0, "maximum": 256},
        "max_joint_arms": {"type": "integer", "minimum": 0, "maximum": 256}
      },
      "additionalProperties": false
    },
    "execution_policy": {
      "enum": ["trusted_scalar_only", "native_screen_then_scalar_refine"]
    }
  },
  "additionalProperties": false
}
