{
  "name": "clozn-studio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm check:colors && pnpm check:copy && tsc -b && vite build",
    "check": "pnpm check:colors && pnpm check:copy && tsc -b --pretty false && vitest run",
    "check:colors": "node scripts/check-raw-colors.mjs",
    "check:copy": "node scripts/check-copy.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/spline-sans": "^5.3.0",
    "@fontsource-variable/spline-sans-mono": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
